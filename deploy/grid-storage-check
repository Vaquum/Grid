#!/bin/sh
# Fail closed: never start Docker on the host filesystem beneath the mount.
set -eu
image=/var/lib/grid.ext4
mountpoint -q /srv/grid
test "$(stat -c %s "$image")" -eq 199000000000
device=$(findmnt -n -o SOURCE --target /srv/grid)
test "$(losetup -n -O BACK-FILE "$device")" = "$image"
test "$(blockdev --getsize64 "$device")" -eq 199000000000
test "$(findmnt -n -o FSTYPE --target /srv/grid)" = ext4
